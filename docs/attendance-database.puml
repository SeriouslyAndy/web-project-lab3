@startuml attendance-database
hide methods
hide stereotypes
skinparam linetype ortho
skinparam classAttributeIconSize 0

entity users {
  * id : uuid
  --
  email : varchar <<unique>>
  password_hash : text
  first_name : varchar
  last_name : varchar
  role : enum
  is_active : boolean
  created_at : timestamptz
}

entity student_profiles {
  * user_id : uuid <<FK>>
  --
  student_number : varchar <<unique>>
  department_id : uuid <<FK>>
  year_level : smallint
}

entity professor_profiles {
  * user_id : uuid <<FK>>
  --
  employee_number : varchar <<unique>>
  department_id : uuid <<FK>>
}

entity departments {
  * id : uuid
  --
  name : varchar <<unique>>
  code : varchar <<unique>>
}

entity courses {
  * id : uuid
  --
  department_id : uuid <<FK>>
  code : varchar
  name : varchar
  description : text
}

entity course_sections {
  * id : uuid
  --
  course_id : uuid <<FK>>
  professor_id : uuid <<FK>>
  academic_year : varchar
  term : varchar
  section_code : varchar
  status : enum
}

entity enrollments {
  * id : uuid
  --
  section_id : uuid <<FK>>
  student_id : uuid <<FK>>
  status : enum
  enrolled_at : timestamptz
  --
  UNIQUE(section_id, student_id)
}

entity class_meetings {
  * id : uuid
  --
  section_id : uuid <<FK>>
  day_of_week : smallint
  start_time : time
  end_time : time
  room_name : varchar
}

entity attendance_sessions {
  * id : uuid
  --
  section_id : uuid <<FK>>
  opened_by : uuid <<FK>>
  session_date : date
  starts_at : timestamptz
  expires_at : timestamptz
  status : enum
  code_hash : text
  code_version : integer
  qr_enabled : boolean
  closed_at : timestamptz
}

entity attendance_records {
  * id : uuid
  --
  attendance_session_id : uuid <<FK>>
  student_id : uuid <<FK>>
  status : enum
  confirmation_method : enum
  confirmed_at : timestamptz
  minutes_late : integer
  --
  UNIQUE(attendance_session_id, student_id)
}

entity attendance_code_attempts {
  * id : uuid
  --
  attendance_session_id : uuid <<FK>>
  student_id : uuid <<FK>>
  code_hash_submitted : text
  result : enum
  attempted_at : timestamptz
}

entity audit_logs {
  * id : uuid
  --
  actor_id : uuid <<FK>>
  action : varchar
  entity_type : varchar
  entity_id : uuid
  old_values : jsonb
  new_values : jsonb
  created_at : timestamptz
}

users ||--o| student_profiles
users ||--o| professor_profiles
departments ||--o{ student_profiles
departments ||--o{ professor_profiles
departments ||--o{ courses
courses ||--o{ course_sections
users ||--o{ course_sections : teaches
course_sections ||--o{ enrollments
users ||--o{ enrollments : attends
course_sections ||--o{ class_meetings
course_sections ||--o{ attendance_sessions
users ||--o{ attendance_sessions : opens
attendance_sessions ||--o{ attendance_records
users ||--o{ attendance_records : confirms
attendance_sessions ||--o{ attendance_code_attempts
users ||--o{ attendance_code_attempts : submits
users ||--o{ audit_logs : creates

note right of attendance_sessions
  Store only a hash of the
  temporary code.
  The code/QR is valid only
  while status = open and
  current time < expires_at.
end note

note right of attendance_records
  Created only after:
  1. valid code or QR
  2. active enrollment
  3. no existing record
end note

note right of attendance_code_attempts
  Store only a submitted-code
  hash or keyed digest.
  Apply rate limits per account,
  session, device, and IP.
end note

note right of audit_logs
  Append-only.
  Never store passwords,
  plaintext codes, QR tokens,
  or sensitive attachments.
end note
@enduml
